# LLM Provider: ollama (default/free/local), groq (free cloud), or openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# Ollama (no API key needed - install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# Groq (free API key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (optional, from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server
MCP_SERVER_URL=http://127.0.0.1:8000/sse
