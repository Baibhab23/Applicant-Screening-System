# LLM Provider: ollama (default/free/local), groq (free cloud), or openai
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1

# Ollama (no API key needed - install from https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434

# Groq (free API key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (optional, from https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# MCP Server
MCP_SERVER_URL=http://127.0.0.1:8000/sse

# Authentication — set both keys to enable JWT auth; omit both for dev-mode (no auth)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
RECRUITER_API_KEY=your_recruiter_api_key_here
ADMIN_API_KEY=your_admin_api_key_here
JWT_EXPIRY_MINUTES=60

# Database — defaults to screening.db in the working directory
DATABASE_PATH=screening.db

# LLM call timeout in seconds (default 30)
LLM_TIMEOUT_SECONDS=30

# Max request body size in bytes (default 1 MB)
MAX_CONTENT_LENGTH_BYTES=1048576
